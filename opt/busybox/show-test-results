#!/bin/bash
# show-test-results — Display test results overlay on DISPLAY :0 (VirtualBox GUI screen)
# Reads /tmp/busybox-unit-tests.xml and /tmp/busybox-health.xml, shows xterm window
DISPLAY="${DISPLAY:-:0}"
XAUTH="/home/busybox/.Xauthority"
UNIT_XML="/tmp/busybox-unit-tests.xml"
HEALTH_XML="/tmp/busybox-health.xml"
RESULT_FILE="/tmp/busybox-test-display.txt"
WIN_TITLE="🤖 Busybox Test Results"

parse_xml() {  # parse_xml FILE → prints "PASS/FAIL name" lines
    local f="$1"
    [ -f "$f" ] || { echo "  (no results file: $f)"; return; }
    local tests failures
    tests=$(grep -o 'tests="[0-9]*"' "$f" | head -1 | grep -o '[0-9]*')
    failures=$(grep -o 'failures="[0-9]*"' "$f" | head -1 | grep -o '[0-9]*')
    local passed=$(( ${tests:-0} - ${failures:-0} ))
    echo "  Tests: $tests | Passed: $passed | Failed: ${failures:-0}"
    # extract testcase names + failures
    while IFS= read -r line; do
        if echo "$line" | grep -q '<testcase'; then
            name=$(echo "$line" | grep -o 'name="[^"]*"' | head -1 | sed 's/name="//;s/"//')
            if echo "$line" | grep -q '/>'; then
                echo "  ✅ $name"
            fi
        elif echo "$line" | grep -q '<failure'; then
            echo "  ❌ (see above)"
        fi
    done < "$f"
}

{
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  🤖 BUSYBOX TEST RESULTS — $(date '+%Y-%m-%d %H:%M:%S')"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "[ UNIT TESTS — Busyman/locate (pytest) ]"
    parse_xml "$UNIT_XML"
    echo ""
    echo "[ HEALTH CHECK — Live Busybox VM ]"
    parse_xml "$HEALTH_XML"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  Press Q or close window to dismiss"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
} > "$RESULT_FILE"

# Kill any existing result window
pkill -f "xterm.*Test.Results" 2>/dev/null || true
sleep 0.3

# Open xterm centered on screen (1280x768 → position 10,10, size 80x30 for full visibility)
DISPLAY="$DISPLAY" XAUTHORITY="$XAUTH" xterm \
    -title "$WIN_TITLE" \
    -geometry "80x30+10+10" \
    -bg "#0d1117" \
    -fg "#e6edf3" \
    -fa "Monospace" -fs 10 \
    -e "cat $RESULT_FILE; echo ''; read -rsn1 -p '' key" \
    &

# Wait for window to appear and raise it above fullscreen vncviewer
sleep 1
DISPLAY="$DISPLAY" XAUTHORITY="$XAUTH" wmctrl -F -a "$WIN_TITLE" 2>/dev/null || \
    DISPLAY="$DISPLAY" XAUTHORITY="$XAUTH" wmctrl -l | grep "Test Results" | awk '{print $1}' | xargs -I{} wmctrl -i -a {} 2>/dev/null || true

echo "Test results displayed on DISPLAY $DISPLAY"
